# Copiá este archivo como .env y completá los valores.
# Este archivo SÍ se versiona, así que no debe contener ni un solo valor real.

# Server
PORT=3000

# Obligatorio. Sin esto el servidor no arranca.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
BREVO_API_KEY=
MAIL_FROM=

# Database. En Render se inyecta sola; en local, apuntá a tu Postgres.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/equipos
